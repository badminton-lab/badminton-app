  "d04": {
    "title": "（削除予定）サイドステップ反復"
  },
  "d12": {
    "coachingPoints": [
      "手首はあまり回さずに、シャトルを体全体で「運ぶ」感覚で",
      "打点は少し高め。ネットの真ん中から白帯のあたりで打ちやすいポイントを探る",
      "スピンをかける場合、手首はあまり回さない"
    ],
    "equipment": [
      "シャトル（綺麗なものが望ましい）",
      "ネット"
    ],
    "variations": [
      "易しく：距離を少し離し、ゆっくり打つ。",
      "難しく：ストレートとクロスを交互に打つ。ミスしたり、高く浮いたりしたほうが負けのミニゲームにする。"
    ],
    "reviewed": true
  },
